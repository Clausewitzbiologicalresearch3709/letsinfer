#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-only
set -euo pipefail
SCRIPT_DIR=$(CDPATH= cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
PROJECT_ROOT=$(CDPATH= cd -P -- "${SCRIPT_DIR}/.." && pwd)
cd "$PROJECT_ROOT"
export PYTHONDONTWRITEBYTECODE=1
exec python3 -m tools.source_archive "$@"
