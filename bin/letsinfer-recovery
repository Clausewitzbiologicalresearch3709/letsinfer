#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
set -eu

name=${1-}
trip_file=${2-}
case "$name" in
    ""|*[!A-Za-z0-9_.-]*)
        echo "FATAL: invalid Let's Infer container name" >&2
        exit 2
        ;;
esac
case "$trip_file" in
    /*/protection-trip.json) ;;
    *) echo "FATAL: invalid Let's Infer protection trip path" >&2; exit 2 ;;
esac

active=$(systemctl --user show letsinfer.service --property ActiveState --value 2>/dev/null || true)
[ "$active" = active ] || exit 0

if [ -f "$trip_file" ]; then
    logger -t letsinfer-recovery "protection trip is latched at $trip_file; refusing automatic engine recovery"
    exit 0
fi

inspection=$(docker inspect \
    --format '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}} {{index .Config.Labels "io.letsinfer.managed"}} {{.State.OOMKilled}}' \
    "$name" 2>/dev/null || true)

if [ -z "$inspection" ]; then
    logger -t letsinfer-recovery "managed container $name is absent; restarting engine service"
    systemctl --user restart --no-block letsinfer-engine.service
    exit 0
fi

set -- $inspection
state=${1-unknown}
health=${2-none}
managed=${3-false}
oom_killed=${4-false}
if [ "$managed" != true ]; then
    logger -t letsinfer-recovery "container $name is not Let's Infer-managed; refusing recovery"
    exit 1
fi

if [ "$oom_killed" = true ]; then
    logger -t letsinfer-recovery "container $name was OOM-killed; refusing automatic recovery"
    exit 0
fi

if [ "$state" != running ] || [ "$health" = unhealthy ] || [ "$health" = none ]; then
    logger -t letsinfer-recovery "container $name state=$state health=$health; restarting engine service"
    systemctl --user restart --no-block letsinfer-engine.service
fi
